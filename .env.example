# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Translation Quality Analytics & Continuous Improvement Platform
# ==============================================================================
# Copy this file to '.env' and populate with your local values.
# NEVER commit the active '.env' file or production secrets to source control.

# Active Translation Provider Selection: 'huggingface' (Default), 'cohere' (Optional), or 'mock' (Testing)
TRANSLATION_PROVIDER=huggingface

# Hugging Face Inference Providers Configuration (DEFAULT)
# Create a user access token with 'Make calls to Inference Providers' permission at:
# https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Cohere API Configuration (OPTIONAL / FUTURE)
# Only required if TRANSLATION_PROVIDER=cohere.
# Get your API key from https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-r

# PostgreSQL Relational Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=translation_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/translation_analytics

# Grafana Observability Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Gradio Web Server Settings
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860

# Apache Spark Settings
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=2g

# Application Logging Settings
LOG_LEVEL=INFO
